<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_picking_type_form_inherit_stock_message" model="ir.ui.view">
        <field name="name">stock.picking.type.form.klo.stock.warning</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Avisos de stock">
                    <field name="show_stock_message"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
