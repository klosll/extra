<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Vista form del wizard -->
    <record id="lot_reception_wizard_view_form" model="ir.ui.view">
        <field name="name">klo.lot.reception.wizard.view.form</field>
        <field name="model">klo.lot.reception.wizard</field>
        <field name="arch" type="xml">
            <form string="Capturar Lotes">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="is_done" invisible="1"/>
                </group>
                <notebook>
                    <page string="Líneas" name="lines">
                        <field name="line_ids"
                               nolabel="1"
                               attrs="{'readonly': [('is_done', '=', True)]}">
                            <tree editable="bottom">
                                <field name="reader_ps" widget="reader_ps_autonext"/>
                                <field name="product_id"/>
                                <field name="lot_name"/>
                                <field name="container"/>
                                <field name="qty_done"/>
                                <field name="surplus"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_validate"
                            string="Validar"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('is_done', '=', True)]}"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
