<odoo>
    <record id="res_config_settings_view_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="quotation_order_setting_container" position="after">
                <block title="Pedidos por WhatsApp con IA" id="klo_whatsapp_order_settings">

                    <!-- Selector de canal -->
                    <setting id="klo_wa_channel_selection" string="Canal de WhatsApp" help="Selecciona el proveedor de WhatsApp que usarás.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="wa_channel" class="col-lg-4 o_light_label"/>
                                <field name="wa_channel" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>

                    <!-- Meta Cloud API (oculto por defecto, visible si wa_channel=meta) -->
                    <setting id="klo_wa_meta_settings" string="Meta Cloud API" help="Credenciales de la WhatsApp Business Cloud API." invisible="wa_channel != 'meta'">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="wa_verify_token" class="col-lg-4 o_light_label"/>
                                <field name="wa_verify_token" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="wa_access_token" class="col-lg-4 o_light_label"/>
                                <field name="wa_access_token" password="True" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="wa_phone_number_id" class="col-lg-4 o_light_label"/>
                                <field name="wa_phone_number_id" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="wa_api_version" class="col-lg-4 o_light_label"/>
                                <field name="wa_api_version" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>

                    <!-- OpenWA (oculto por defecto, visible si wa_channel=openwa) -->
                    <setting id="klo_wa_openwa_settings" string="OpenWA (Self-Hosted)" help="Gateway open source auto-hospedado. Usa WhatsApp Web (sin cuenta de negocio)." invisible="wa_channel != 'openwa'">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="openwa_base_url" class="col-lg-4 o_light_label"/>
                                <field name="openwa_base_url" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="openwa_api_key" class="col-lg-4 o_light_label"/>
                                <field name="openwa_api_key" password="True" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="openwa_session_id" class="col-lg-4 o_light_label"/>
                                <field name="openwa_session_id" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="openwa_webhook_secret" class="col-lg-4 o_light_label"/>
                                <field name="openwa_webhook_secret" password="True" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>

                    <!-- Proveedor de IA -->
                    <setting id="klo_wa_mimo_settings" string="Xiaomi MiMo" help="Proveedor de IA principal (recomendado). API compatible con OpenAI.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="use_mimo" class="col-lg-4 o_light_label"/>
                                <field name="use_mimo" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="mimo_api_key" class="col-lg-4 o_light_label"/>
                                <field name="mimo_api_key" password="True" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="mimo_model" class="col-lg-4 o_light_label"/>
                                <field name="mimo_model" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="mimo_base_url" class="col-lg-4 o_light_label"/>
                                <field name="mimo_base_url" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="klo_wa_openai_settings" string="OpenAI (fallback)" help="Proveedor alternativo. Se usa solo si MiMo está desactivado.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="openai_api_key" class="col-lg-4 o_light_label"/>
                                <field name="openai_api_key" password="True" class="col-lg-8"/>
                            </div>
                            <div class="row mt16">
                                <label for="openai_model" class="col-lg-4 o_light_label"/>
                                <field name="openai_model" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>

                    <!-- Control de gasto -->
                    <setting id="klo_wa_ai_limits" string="Control de gasto de IA" help="Limita el consumo diario de tokens y el coste mensual. Usa 0 para sin límite.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="wa_max_tokens_per_day" class="col-lg-6 o_light_label"/>
                                <field name="wa_max_tokens_per_day" class="col-lg-6"/>
                            </div>
                            <div class="row mt16">
                                <label for="wa_max_cost_per_month" class="col-lg-6 o_light_label"/>
                                <field name="wa_max_cost_per_month" class="col-lg-6"/>
                            </div>
                        </div>
                    </setting>

                    <!-- Comportamiento de pedidos -->
                    <setting id="klo_wa_order_behavior" string="Comportamiento de pedidos" help="Define el flujo de confirmación y la sesión por defecto.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="wa_auto_confirm_order" class="col-lg-6 o_light_label"/>
                                <field name="wa_auto_confirm_order" class="col-lg-6"/>
                            </div>
                            <div class="row mt16">
                                <label for="wa_order_team_id" class="col-lg-6 o_light_label"/>
                                <field name="wa_order_team_id" class="col-lg-6"/>
                            </div>
                            <div class="row mt16">
                                <label for="wa_session_timeout_hours" class="col-lg-6 o_light_label"/>
                                <field name="wa_session_timeout_hours" class="col-lg-6"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
