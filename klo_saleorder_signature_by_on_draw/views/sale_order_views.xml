<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_signature_by_on" model="ir.ui.view">
        <field name="name">sale.order.form.klo.signature.by.on</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='customer_signature']" position="attributes">
                <attribute name="attrs">{'invisible': [('require_signature', '=', False), ('signed_by', '=', False), ('customer_signature', '=', False), ('signed_on', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='customer_signature']//field[@name='signature']" position="replace">
                <field name="customer_signature" widget="signature"/>
            </xpath>
        </field>
    </record>
</odoo>
