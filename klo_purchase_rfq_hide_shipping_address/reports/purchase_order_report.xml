<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Solicitud de presupuesto (RFQ): ocultar la dirección de envío de la cabecera
         mientras el documento no esté confirmado.
         Se anula la variable information_block (bloque de dirección complementaria del
         layout) en lugar de tocar el t-if/t-else, para no interferir con el t-else que
         añade purchase_stock (dirección del almacén). -->
    <template id="klo_purchase_quotation_report_hide_shipping_address"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//div[@class='page']" position="before">
            <t t-if="o.state in ('draft', 'sent', 'to approve')">
                <t t-set="information_block" t-value="None"/>
            </t>
        </xpath>
    </template>

    <!-- Pedido de compra (PO): ocultar la dirección de envío solo mientras siga siendo RFQ -->
    <template id="klo_purchase_order_report_hide_shipping_address"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@class='page']" position="before">
            <t t-if="o.state in ('draft', 'sent', 'to approve')">
                <t t-set="information_block" t-value="None"/>
            </t>
        </xpath>
    </template>

</odoo>
