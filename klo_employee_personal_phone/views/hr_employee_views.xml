<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_tree_inherit_klo_personal_phone" model="ir.ui.view">
        <field name="name">hr.employee.tree.klo.personal.phone</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_phone']" position="after">
                <field name="phone" groups="hr.group_hr_manager" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
