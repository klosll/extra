<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario de lote: campo debajo de "Precio de compra" (purchase_cost) -->
    <record id="view_production_lot_form" model="ir.ui.view">
        <field name="name">stock.production.lot.form.last.cost</field>
        <field name="model">stock.production.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']/group[2]/field[@name='purchase_cost']" position="after">
                <field name="purchase_last_cost"/>
            </xpath>
        </field>
    </record>

    <!-- Lista del informe de inventario "stock a mano": campos opcionales -->
    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.last.cost</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="purchase_last_cost" optional="show"/>
                <field name="purchase_last_value" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
