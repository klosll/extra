<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- HT02695: aceptar lotes sin compañía (productos compartidos en v18) -->
  <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
    <field name="name">stock.move.line.operations.tree - klo_stock_picking_filter_lot_no_company</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock_picking_filter_lot.view_stock_move_line_operation_tree" />
    <field name="priority">25</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='lot_id']" position="attributes">
        <attribute name="domain">
                    [('product_id','=', parent.product_id), '|', ('company_id', '=', False), ('company_id', '=', company_id), ('location_ids', 'child_of', location_id)]
                </attribute>
      </xpath>
    </field>
  </record>

  <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
    <field name="name">stock.move.line.detailed.operations.tree - klo_stock_picking_filter_lot_no_company</field>
    <field name="model">stock.move.line</field>
    <field
      name="inherit_id"
      ref="stock_picking_filter_lot.view_stock_move_line_detailed_operation_tree"
    />
    <field name="priority">25</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='lot_id']" position="attributes">
        <attribute name="domain">
                    [('product_id','=', product_id), '|', ('company_id', '=', False), ('company_id', '=', company_id), ('location_ids', 'child_of', location_id)]
                </attribute>
      </xpath>
    </field>
  </record>
</odoo>
