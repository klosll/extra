<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="batch_movement_detail_wizard_form" model="ir.ui.view">
        <field name="name">batch.movement.detail.wizard.form</field>
        <field name="model">batch.movement.detail.wizard</field>
        <field name="arch" type="xml">
            <form string="Detalle de existencias crianzas/madres">
                <group>
                    <field name="date" />
                </group>
                <footer>
                    <button
                        name="button_create_report"
                        string="Generar"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_batch_movement_detail_wizard" model="ir.actions.act_window">
        <field name="name">Detalle de existencias crianzas/madres</field>
        <field name="res_model">batch.movement.detail.wizard</field>
        <field
            name="binding_model_id"
            ref="stock_picking_batch.model_stock_picking_batch"
        />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
