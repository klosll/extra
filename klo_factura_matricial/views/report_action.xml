<?xml version="1.0" encoding="utf-8"?>
<!--
    KLO. Acción de reporte "Factura Matricial" para account.move.

    binding_view_types: form -> solo visible en la vista formulario de la
    factura (menú Imprimir). Los grupos de contabilidad (facturación y solo
    lectura) pueden usarla.
-->
<odoo>
    <data>
        <record id="action_report_factura_matricial" model="ir.actions.report">
            <field name="name">Factura Matricial</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">klo_factura_matricial.report_factura_matricial</field>
            <field name="report_file">klo_factura_matricial.report_factura_matricial</field>
            <field name="paperformat_id" ref="paperformat_factura_matricial"/>
            <field name="print_report_name">(object.name or 'Factura Matricial').replace('/', '-')</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">form</field>
            <field name="groups_id" eval="[(4, ref('account.group_account_invoice')),
 (4, ref('account.group_account_readonly'))]"/>
        </record>
    </data>
</odoo>
