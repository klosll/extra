<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <record model="ir.ui.view" id="view_company_form">
         <field name="model">res.company</field>
         <field name="inherit_id" ref="base.view_company_form" />
         <field name="arch" type="xml">
            <!-- v18: el campo favicon ya no existe en base.view_company_form;
                 se ancla después del campo logo (imagen de la compañía) -->
            <field name="logo" position="after">
                <field name="liquidation_stamp" widget="image" class="float-left oe_avatar" />
            </field>
         </field>
     </record>
</odoo>
