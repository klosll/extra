<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pedido de compra (PO): ocultar la columna "Segunda Ctd" (Second Qty) -->
    <template id="klo_purchase_hide_secondary_qty_order"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_secondary_unit']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@id='secondary_unit']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <!-- Solicitud de presupuesto (RFQ): ocultar la columna "Segunda Ctd" (Second Qty) -->
    <template id="klo_purchase_hide_secondary_qty_quotation"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//th[@name='secondary_unit']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@id='secondary_unit']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

</odoo>
